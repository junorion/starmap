# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local settings
.claude/settings.local.json
.claude/launch.json

# worktree
.claude/worktrees

# android (android/ 의 WebView 래퍼)
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
# 서명 키와 비밀번호 — 저장소 밖(~/keystores/)에 둔다
/android/keystore.properties
*.jks
*.keystore
*.apk
*.aab
